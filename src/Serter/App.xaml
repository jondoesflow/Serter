<Application x:Class="Serter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Serter.Converters"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Dark, club-friendly palette -->
      <Color x:Key="BgColor">#FF15161A</Color>
      <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="Surface" Color="#FF1F2127" />
      <SolidColorBrush x:Key="SurfaceHover" Color="#FF292C34" />
      <SolidColorBrush x:Key="Border" Color="#FF30333C" />
      <SolidColorBrush x:Key="Text" Color="#FFF2F3F5" />
      <SolidColorBrush x:Key="TextDim" Color="#FF9BA0AB" />
      <SolidColorBrush x:Key="DeckA" Color="#FF3FA9F5" />
      <SolidColorBrush x:Key="DeckB" Color="#FFF5A623" />
      <SolidColorBrush x:Key="Good" Color="#FF34C77B" />
      <SolidColorBrush x:Key="Ok" Color="#FFE8B33A" />
      <SolidColorBrush x:Key="Bad" Color="#FFE5534B" />
      <SolidColorBrush x:Key="Unknown" Color="#FF5D626D" />

      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
      <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      </Style>

      <!-- Flat button -->
      <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- One half of the A | B switch -->
      <Style x:Key="DeckToggle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="18,5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Setter Property="Foreground" Value="#FF101114" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsChecked" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Small rounded chip for BPM / key / genre -->
      <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="#FF2A2D35" />
      </Style>

      <Style x:Key="Dark" TargetType="Control">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource Dark}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
      </Style>
      <Style TargetType="PasswordBox" BasedOn="{StaticResource Dark}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
